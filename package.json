{
	"name": "cabinet",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env --watch-path=server server/main.ts",
		"dev:web": "vite dev --port 5173",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env server/main.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src",
		"test": "node --test 'tests/**/*.test.ts'",
		"db:generate": "drizzle-kit generate",
		"import-legacy": "node --env-file-if-exists=.env scripts/import-legacy.ts",
		"lint": "oxlint",
		"format": "oxfmt",
		"check": "oxlint && oxfmt --check && pnpm typecheck && pnpm test"
	},
	"dependencies": {
		"@a2ui/web_core": "0.15.0",
		"@earendil-works/chord": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-codemode": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@earendil-works/pi-schema": "1.5.0",
		"@larksuiteoapi/node-sdk": "^1.76.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@tanstack/react-query": "^5.105.3",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"@tursodatabase/database": "0.8.3",
		"drizzle-orm": "^0.45.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"drizzle-kit": "^0.31.11",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"tailwindcss": "^4.3.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"engines": {
		"node": ">=24"
	}
}
