# 飞书应用（开发者后台 → 凭证与基础信息）。机器人身份由 SDK 自动换 tenant token
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
# 机器人和自己的 open_id，用于过滤自己发的消息、判断私聊是不是本人
BOT_OPEN_ID=ou_xxx
OWNER_OPEN_ID=ou_xxx
OWNER_NAME=Yi
# 用户身份授权回调，必须和后台「安全设置 → 重定向 URL」一致；只在点「授权飞书」时临时监听
OAUTH_REDIRECT=http://127.0.0.1:9768/callback

# 只响应这里列出的群里的 @机器人：chat_id:该群工作目录，逗号分隔。为空时只响应本人私聊
CHATS=
# 私聊和未配置目录时的工作目录
DEFAULT_CWD=~/code

# launchd 不读 shell 配置，命令写绝对路径
MEEGLE_BIN=/usr/local/bin/meegle
GLAB_BIN=/opt/homebrew/bin/glab

# 未在 config/agents.json 指定时的默认模型
PI_MODEL=claude/claude-opus-5-5
PI_THINKING=medium
# 主模型额度用完、限流或过载时换用的模型；单个 agent 可在 agents.json 用 fallbackModel 覆盖
PI_FALLBACK_MODEL=codex/gpt-6.1-sol
PI_TIMEOUT=600
MAX_CONCURRENCY=3
THREAD_CONTEXT_N=15
# 截图在 data/images 保留的天数；会话闲置超过这么多天就换新会话，旧上下文和图片不再每轮重发。0 = 不清理 / 不换
IMAGE_RETAIN_DAYS=7
SESSION_IDLE_DAYS=7

# 代回复草稿：轮询你的私聊和 @你 的群消息，草稿私聊给你，确认后才以你的身份发出
DRAFT_ENABLED=1
POLL_INTERVAL=30
POLL_TOP_N=15
# 不起草的会话（逗号分隔 chat_id），比如经常 @你 的通知群
DRAFT_SKIP_CHATS=

# 飞书项目评论 @你：读「飞书项目」机器人的通知卡片，回复用 meegle 以你的身份发评论
MEEGO_ENABLED=1
MEEGO_CHAT=

# 长期记忆：约定每次都带，线索按关键词 + 向量召回、过门槛才带；草稿反馈和工具结果自动提取
MEMORY_ENABLED=1
# 提取与「记住」分类用的模型，默认同 PI_MODEL
# MEMORY_MODEL=claude/claude-opus-5-5
# 向量走本机 Ollama（/api/embed）；留空则只用关键词。挂了会自动退成关键词并退避重试
EMBED_URL=http://127.0.0.1:11434
EMBED_MODEL=qwen3-embedding:4b
# 门槛按 qwen3-embedding:4b + 默认查询前缀校准；换模型或前缀要重新校准（看板「记忆」里的试召回会显示两臂分数）
# MEMORY_MIN_SIMILARITY=0.58
# MEMORY_MIN_KEYWORD=1.0
# MEMORY_MIN_KEYWORD_COSINE=0.45

# 看板端口（只监听 127.0.0.1）。开发时 vite 跑在 5173，需放行该来源
PORT=10086
# DEV_ORIGIN=http://localhost:5173
# 运行数据目录（数据库、pi 会话、记忆、表情包），默认 ./data
# DATA_DIR=data
